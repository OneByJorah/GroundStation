# GroundStation Configuration

# Server
HOST=0.0.0.0
PORT=5000
GS_ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./data/groundstation.db
# DATABASE_URL=postgresql://user:password@localhost/groundstation

# SDR Hardware
SDR_DEVICE_INDEX=0
SDR_SAMPLE_RATE=2.4e6
SDR_CENTER_FREQ=100e6
SDR_GAIN=20

# Audio / Transcription
DEEPGRAM_API_KEY=
GEMINI_API_KEY=

# WebRTC
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Logging
LOG_LEVEL=info
